{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kori",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",

  // Replace this hostname before using the template.
  "routes": [
    {
      "pattern": "kori.example.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,

  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "placement": {
    "mode": "smart"
  },
  "ratelimits": [
    {
      "name": "UPSTREAM_RATE_LIMITER",
      // Choose a positive integer that is unique within the target account.
      "namespace_id": "5674001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "vars": {
    "WALRUS_AGGREGATOR_URL": "https://aggregator.walrus.atalma.io"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
